<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                    http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Aggregate\Buyer\PaymentMethod" table="payment_method">
        <id name="id" type="integer" column="id">
            <generator strategy="SEQUENCE"/>
        </id>
        <field name="alias" type="string" column="alias" length="200"/>
        <field name="cardHolderName" type="string" column="card_holder_name" length="200"/>
        <field name="cardNumber" type="string" column="card_number" length="25"/>
        <field name="expiration" type="datetime_immutable" column="expiration"/>

        <many-to-one field="buyer" target-entity="Buyer">
            <join-column name="buyer_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <many-to-one field="cardType" target-entity="CardType">
            <join-column name="card_type_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>

