<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                    http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Aggregate\Buyer\Buyer" table="buyer">
        <id name="id" type="integer" column="id">
            <generator strategy="SEQUENCE"/>
        </id>
        <field name="identityGuid" type="string" length="200" column="identity_guid" unique="true"/>
        <field name="name" type="string" column="name" nullable="true"/>

        <one-to-many field="paymentMethods" target-entity="PaymentMethod" mapped-by="buyer"/>
    </entity>
</doctrine-mapping>

