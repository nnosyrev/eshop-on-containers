<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                    http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Aggregate\Order\Order" table="order">
        <id name="id" type="integer" column="id">
            <generator strategy="SEQUENCE"/>
        </id>
        <field name="buyerId" type="integer" column="buyer_id" nullable="true"/>
        <field name="paymentMethodId" type="integer" column="payment_method_id" nullable="true"/>
        <field name="orderStatusId" type="integer" column="order_status_id"/>
    </entity>
</doctrine-mapping>

