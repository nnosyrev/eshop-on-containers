<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                    http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Aggregate\Order\Order" table="order">
        <id name="id" type="integer" column="id">
            <generator strategy="SEQUENCE"/>
        </id>
        <field name="orderStatus" type="integer" column="order_status"/>
        <field name="description" type="string" column="description" nullable="true"/>
        <field name="orderDate" type="datetime_immutable" column="order_date"/>

        <embedded name="address" class="Address"/>

        <one-to-many field="orderItems" target-entity="OrderItem" mapped-by="order"/>

        <many-to-one field="buyer" target-entity="App\Domain\Aggregate\Buyer\Buyer"/>
        <many-to-one field="paymentMethod" target-entity="App\Domain\Aggregate\Buyer\PaymentMethod"/>
    </entity>
</doctrine-mapping>

